generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Campus {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  classes   Class[]
  admins    Admin[]

  @@map("campuses")
}

model Class {
  id          String   @id @default(cuid())
  name        String
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id])
  schoolYear  String
  teacherName String?
  createdAt   DateTime @default(now())
  students    Student[]
  admins      Admin[]

  @@index([campusId])
  @@unique([name, campusId, schoolYear])
  @@map("classes")
}

model Student {
  id             String          @id @default(cuid())
  studentCode    String          @unique
  cccd           String?         @unique
  fullName       String
  classId        String
  class          Class           @relation(fields: [classId], references: [id])
  phone          String?
  parentPhone    String?
  dateOfBirth    DateTime?
  passwordHash   String
  passwordIsDefault Boolean       @default(true)
  zaloPhone      String?
  createdAt      DateTime        @default(now())
  feeAssignments FeeAssignment[]
  notifications  Notification[]

  @@index([classId])
  @@index([phone])
  @@map("students")
}

model FeeType {
  id                String          @id @default(cuid())
  name              String
  description       String?
  amount            Float           @default(0)
  bankAccountNumber String?
  bankAccountName   String?
  bankName          String          @default("Agribank")
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  feeAssignments    FeeAssignment[]

  @@map("fee_types")
}

model FeeAssignment {
  id            String         @id @default(cuid())
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id])
  feeTypeId     String
  feeType       FeeType        @relation(fields: [feeTypeId], references: [id])
  amount        Float
  academicYear  String
  dueDate       DateTime?
  qrContent     String?
  status        String         @default("pending")
  paidAt        DateTime?
  bhytCategory  String?
  bhytMonths    Int?
  bhytNote      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  paymentProofs PaymentProof[]
  notifications Notification[]

  @@index([studentId])
  @@index([feeTypeId])
  @@index([status])
  @@index([bhytCategory])
  @@unique([studentId, feeTypeId, academicYear])
  @@map("fee_assignments")
}

model BankTransaction {
  id                   String   @id @default(cuid())
  provider             String
  providerTransactionId String
  gateway              String?
  accountNumber        String
  transactionDate      DateTime?
  content              String
  transferType         String
  transferAmount       Float
  referenceCode        String?
  matchedAssignmentId  String?
  status               String   @default("unmatched")
  rawPayload           Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([provider, providerTransactionId])
  @@index([accountNumber, transactionDate])
  @@index([matchedAssignmentId])
  @@map("bank_transactions")
}

model PaymentProof {
  id              String        @id @default(cuid())
  feeAssignmentId String
  feeAssignment   FeeAssignment @relation(fields: [feeAssignmentId], references: [id])
  imageUrl        String
  cloudStoragePath String?
  isPublic        Boolean       @default(false)
  note            String?
  uploadedAt      DateTime      @default(now())
  verifiedBy      String?
  verifiedAt      DateTime?

  @@index([feeAssignmentId])
  @@map("payment_proofs")
}

model Notification {
  id              String         @id @default(cuid())
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id])
  feeAssignmentId String?
  feeAssignment   FeeAssignment? @relation(fields: [feeAssignmentId], references: [id])
  type            String         @default("reminder")
  channel         String         @default("website")
  message         String
  sentAt          DateTime       @default(now())
  isRead          Boolean        @default(false)

  @@index([studentId])
  @@map("notifications")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         String   @default("admin")
  campusId     String?
  campus       Campus?  @relation(fields: [campusId], references: [id])
  classId      String?
  class        Class?    @relation(fields: [classId], references: [id])
  createdAt    DateTime @default(now())

  @@map("admins")
  @@index([classId])
}

// NextAuth required tables
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
